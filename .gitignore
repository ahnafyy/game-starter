*.sln
*.suo

# macOS Xcode project files (regenerate with right-click → Generate Xcode project)
*.xcworkspace/
*.xcodeproj/

# Lyra content & plugins — Epic Games EULA prohibits redistribution.
# To set up locally: copy from your Lyra Starter Game install (via Epic Games Launcher)
#   xcopy "<LyraPath>\Content" "Game\Content" /E /I /Y
#   xcopy "<LyraPath>\Plugins\CommonGame" "Game\Plugins\CommonGame" /E /I /Y
#   xcopy "<LyraPath>\Plugins\GameplayMessageRouter" "Game\Plugins\GameplayMessageRouter" /E /I /Y
Game/Content/
Game/Plugins/CommonGame/
Game/Plugins/CommonUser/
Game/Plugins/GameplayMessageRouter/
Game/Plugins/UnrealMCP/MCPGameProject/Content/

# UE generated headers
*.generated.h

