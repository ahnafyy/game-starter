# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM provider — pick ONE block and uncomment it ───────────────────────────

# GitHub Models (free tier, uses your GitHub PAT — recommended to start)
# Get a token at https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=github_pat_...
# LLM_BASE_URL=https://models.inference.ai.azure.com  # this is the default
# LLM_MODEL=gpt-4o-mini                               # this is the default

# OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Groq (fast + cheap)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-4-scout-17b-16e-instruct

# Ollama (local, free)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ── Unreal MCP server (default matches the plugin) ───────────────────────────
UNREAL_MCP_HOST=localhost
UNREAL_MCP_PORT=55557
